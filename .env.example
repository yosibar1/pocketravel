# --- Auth (optional in demo mode; app falls back to guest mode without these) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- AI trip planner (optional; falls back to the built-in rules engine) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Live flight prices (optional; falls back to demo data) ---
# Sign up free at https://www.travelpayouts.com -> Tools -> API -> copy your token
TRAVELPAYOUTS_TOKEN=
